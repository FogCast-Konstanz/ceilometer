# Pi-initiated polling: use an outbound HTTPS clone URL on restricted networks.
# Example: https://github.com/OWNER/REPOSITORY.git
# Never embed a token/password in this URL.
CEILOMETER_GIT_URL=REPLACE_WITH_GIT_URL
CEILOMETER_GIT_REF=refs/heads/deploy
# Explicitly targets one Pico; change only when replacing that board.
CEILOMETER_PICO_SERIAL=REPLACE_WITH_PICO_USB_SERIAL
