        </mxCell>
        <mxCell id="idle" value="&lt;b&gt;Independent live count-rate diagnostic&lt;/b&gt;&lt;br&gt;&lt;br&gt;When not acquiring: count_window samples PWM2 locally&lt;br&gt;Accumulates wraps over 50 ms; reports count, elapsed time and max gap&lt;br&gt;Web GUI computes cps, refreshes about twice per second&lt;br&gt;No pulse source is started; display pauses during acquisition" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f3ed;strokeColor=#53677b;fontColor=#172b3a;fontFamily=Helvetica;fontSize=17;spacing=15;arcSize=8;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="50" y="885" width="625" height="135" as="geometry" />
        </mxCell>
        <mxCell id="notes" value="PIO start and PWM timer start are ordered software writes, not a common hardware strobe.&lt;br&gt;Fixed phase, timing jitter and range offset still require external timing calibration." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#172b3a;" vertex="1" parent="1">
