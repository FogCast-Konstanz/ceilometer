        <mxCell id="a8" value="ready burst" source="irq" target="hist" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#52677a;strokeWidth=2;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="corr" value="&lt;b&gt;Correlation &amp;amp; readback&lt;/b&gt;&lt;br&gt;&lt;br&gt;DC-rejected circular PRN correlation&lt;br&gt;1023 signed int64 profile values&lt;br&gt;Raw / histogram / profile → USB pages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1f8;strokeColor=#53677b;fontColor=#172b3a;fontFamily=Helvetica;fontSize=18;spacing=15;arcSize=8;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1190" y="885" width="420" height="135" as="geometry" />
        </mxCell>
        <mxCell id="a9" value="requested frames complete" source="hist" target="corr" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#52677a;strokeWidth=2;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry" />
