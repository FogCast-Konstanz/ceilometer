        <mxCell id="tx" value="&lt;b&gt;Transmitter control&lt;/b&gt;&lt;br&gt;&lt;br&gt;Laser arm &amp;amp; current DAC · PRN emission&lt;br&gt;DS18B20 must be valid, default 10–30 °C&lt;br&gt;Default PRN: 1023 symbols at 10 MHz&lt;br&gt;GP4 emits; dark captures use GP13" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1f8;strokeColor=#53677b;fontColor=#172b3a;fontFamily=Helvetica;fontSize=18;spacing=15;arcSize=8;align=center;verticalAlign=middle;" vertex="1" parent="1">
