        <mxCell id="txhw" value="&lt;b&gt;Transmitter hardware&lt;/b&gt;&lt;br&gt;&lt;br&gt;I²C0: U2 laser DAC (0x4C)&lt;br&gt;iC-HG30 gate / active-low fault (GP16)&lt;br&gt;ADC0 current monitor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f5f7;strokeColor=#53677b;fontColor=#172b3a;fontFamily=Helvetica;fontSize=17;spacing=15;arcSize=8;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="50" y="875" width="450" height="125" as="geometry" />
        </mxCell>
        <mxCell id="techw" value="&lt;b&gt;Thermal hardware&lt;/b&gt;&lt;br&gt;&lt;br&gt;LT8722: SPI1 / CS + shared SWEN&lt;br&gt;13 distinct AOUT monitor sources → ADC1&lt;br&gt;Laser-mounted DS18B20" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f5f7;strokeColor=#53677b;fontColor=#172b3a;fontFamily=Helvetica;fontSize=17;spacing=15;arcSize=8;align=center;verticalAlign=middle;" vertex="1" parent="1">
