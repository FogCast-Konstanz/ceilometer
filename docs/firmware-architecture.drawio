  <diagram name="PRN acquisition path" id="PRN-acquisition-path">
    <mxGraphModel dx="1700" dy="1200" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1700" pageHeight="1180" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;PRN generation, photon counting &amp;amp; processing&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=30;fontColor=#172b3a;" vertex="1" parent="1">
          <mxGeometry x="45" y="25" width="1600" height="55" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Nominal symbol rate: 10 MHz · 1023-symbol frames · finite bursts of up to 16 frames" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontColor=#172b3a;" vertex="1" parent="1">
          <mxGeometry x="45" y="85" width="1600" height="35" as="geometry" />
        </mxCell>
        <mxCell id="sequence" value="&lt;b&gt;PRN sequence&lt;/b&gt;&lt;br&gt;&lt;br&gt;10-bit maximal-length sequence&lt;br&gt;Seed → 1023 bits&lt;br&gt;Packed across frame boundaries" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1f8;strokeColor=#53677b;fontColor=#172b3a;fontFamily=Helvetica;fontSize=18;spacing=15;arcSize=8;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="50" y="170" width="290" height="135" as="geometry" />
        </mxCell>
        <mxCell id="txdma" value="&lt;b&gt;TX DMA&lt;/b&gt;&lt;br&gt;&lt;br&gt;SRAM words → PIO0 TX FIFO&lt;br&gt;PIO TX DREQ paced&lt;br&gt;FIFO primed before start" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1f8;strokeColor=#53677b;fontColor=#172b3a;fontFamily=Helvetica;fontSize=18;spacing=15;arcSize=8;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="405" y="170" width="270" height="135" as="geometry" />
        </mxCell>
        <mxCell id="pio" value="&lt;b&gt;PIO0 state machines&lt;/b&gt;&lt;br&gt;&lt;br&gt;SM0: data + chip sync&lt;br&gt;10 cycles / symbol · integer divider 5&lt;br&gt;SM1: frame sync, same divider" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1f8;strokeColor=#53677b;fontColor=#172b3a;fontFamily=Helvetica;fontSize=18;spacing=15;arcSize=8;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="740" y="170" width="360" height="135" as="geometry" />
        </mxCell>
        <mxCell id="outputs" value="&lt;b&gt;Digital outputs&lt;/b&gt;&lt;br&gt;&lt;br&gt;GP4: laser modulation when armed&lt;br&gt;GP13: PRN during dark captures&lt;br&gt;GP6 / GP7: chip / frame sync" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f5f7;strokeColor=#53677b;fontColor=#172b3a;fontFamily=Helvetica;fontSize=18;spacing=15;arcSize=8;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1190" y="170" width="420" height="135" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="" source="sequence" target="txdma" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#52677a;strokeWidth=2;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="" source="txdma" target="pio" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#52677a;strokeWidth=2;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="" source="pio" target="outputs" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#52677a;strokeWidth=2;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="photon" value="&lt;b&gt;Receiver pulse input&lt;/b&gt;&lt;br&gt;&lt;br&gt;Comparator / LVDS receiver&lt;br&gt;GP5: rising-edge input&lt;br&gt;Threshold set by U16 DAC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f5f7;strokeColor=#53677b;fontColor=#172b3a;fontFamily=Helvetica;fontSize=18;spacing=15;arcSize=8;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="50" y="435" width="290" height="135" as="geometry" />
        </mxCell>
        <mxCell id="pwmcounter" value="&lt;b&gt;PWM2 edge counter&lt;/b&gt;&lt;br&gt;&lt;br&gt;16-bit free-running CTR&lt;br&gt;Hardware counts independently&lt;br&gt;Modulo-65536 differences" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1f8;strokeColor=#53677b;fontColor=#172b3a;fontFamily=Helvetica;fontSize=18;spacing=15;arcSize=8;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="405" y="435" width="270" height="135" as="geometry" />
        </mxCell>
        <mxCell id="rxdma" value="&lt;b&gt;RX DMA / sample buffer&lt;/b&gt;&lt;br&gt;&lt;br&gt;PWM0 wrap DREQ → 32-bit CTR reads&lt;br&gt;Incrementing SRAM destination&lt;br&gt;1023 × burst frames + 1 samples" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1f8;strokeColor=#53677b;fontColor=#172b3a;fontFamily=Helvetica;fontSize=18;spacing=15;arcSize=8;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="740" y="435" width="360" height="135" as="geometry" />
        </mxCell>
        <mxCell id="irq" value="&lt;b&gt;DMA completion IRQ&lt;/b&gt;&lt;br&gt;&lt;br&gt;Stop timer and PRN generation&lt;br&gt;Capture elapsed time / TX starvation&lt;br&gt;Publish ready or failed status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1f8;strokeColor=#53677b;fontColor=#172b3a;fontFamily=Helvetica;fontSize=18;spacing=15;arcSize=8;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1190" y="435" width="420" height="135" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="" source="photon" target="pwmcounter" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#52677a;strokeWidth=2;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="" source="pwmcounter" target="rxdma" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#52677a;strokeWidth=2;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a6" value="" source="rxdma" target="irq" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#52677a;strokeWidth=2;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="timer" value="&lt;b&gt;PWM0 sample timer&lt;/b&gt;&lt;br&gt;&lt;br&gt;500 MHz / 50 → 10 MHz bin rate&lt;br&gt;Divider 1 · wrap 49&lt;br&gt;100 ns nominal bin interval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eefa;strokeColor=#53677b;fontColor=#172b3a;fontFamily=Helvetica;fontSize=18;spacing=15;arcSize=8;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="740" y="665" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="a7" value="DREQ" source="timer" target="rxdma" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#52677a;strokeWidth=2;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#ffffff;entryX=0.5;entryY=1;exitX=0.5;exitY=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hist" value="&lt;b&gt;Foreground accumulation&lt;/b&gt;&lt;br&gt;&lt;br&gt;Δcounter per bin → uint64 histogram&lt;br&gt;Fold / integrate over 1023 bins&lt;br&gt;Start further finite bursts as required" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1f8;strokeColor=#53677b;fontColor=#172b3a;fontFamily=Helvetica;fontSize=18;spacing=15;arcSize=8;align=center;verticalAlign=middle;" vertex="1" parent="1">
