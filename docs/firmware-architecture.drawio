        </mxCell>
        <mxCell id="runtime" value="&lt;b&gt;Acquisition supervision&lt;/b&gt;&lt;br&gt;&lt;br&gt;Command handler selects rate / frame count / dark or emitting&lt;br&gt;Cache-based safety checks during DMA; bus services between bursts&lt;br&gt;Overflow, timeout or TX starvation → common emergency stop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0ec;strokeColor=#53677b;fontColor=#172b3a;fontFamily=Helvetica;fontSize=17;spacing=15;arcSize=8;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="50" y="665" width="625" height="120" as="geometry" />
        </mxCell>
        <mxCell id="a11" value="schedule bursts" source="runtime" target="hist" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#52677a;strokeWidth=2;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=1;entryX=0;entryY=0.5;">
