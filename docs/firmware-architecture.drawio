        <mxCell id="a10" value="reference code" source="sequence" target="corr" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#52677a;strokeWidth=2;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=0;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="25" y="340" />
              <mxPoint x="25" y="830" />
              <mxPoint x="1400" y="830" />
